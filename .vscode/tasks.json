// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: compile",
            "type": "shell",
            "command": "npm",
            "args": ["run", "compile"],
            "problemMatcher": ["$tsc", "$eslint-stylish"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$tsc", "$esbuild"],
			"label": "npm: compile"
		},
		{
            "label": "watch",
            "dependsOn": [
                "npm: watch:esbuild",
                "npm: watch:tsc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$esbuild-watch", "$tsc-watch"],
            "isBackground": true
        },
        {
            "type": "npm",
            "script": "watch:esbuild",
            "group": "build",
            "problemMatcher": "$esbuild-watch",
            "isBackground": true,
            "label": "npm: watch:esbuild",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
		{
            "type": "npm",
            "script": "watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "npm: watch:tsc",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
		{
			"type": "npm",
			"script": "watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			},
			"group": "build"
		}
	]
}
