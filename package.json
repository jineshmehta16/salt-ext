{
  "name": "salt",
  "displayName": "Salt",
  "publisher": "Jinesh Mehta",
  "author": "Jinesh Mehta",
  "description": "Salt Design System Assistant - AI-powered helper for Salt Design System",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpmorganchase/salt-ds"
  },
  "keywords": [
    "salt",
    "design system",
    "ui",
    "components",
    "chat",
    "ai",
    "assistant"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onChat:salt",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "salt",
        "name": "salt",
        "fullName": "Salt Design System",
        "description": "Get help with Salt Design System components and features",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "npm run watch:esbuild",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -w -p ./",
    "package": "node esbuild.js --production",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
